DATABASE_URL="postgresql://mcp:mcp@localhost:5433/toolplane?schema=public"

# Secret used to sign session JWT cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL used in generated install scripts, callbacks, and connection snippets.
NEXT_PUBLIC_APP_URL="http://localhost:10030"
# Set only when every request reaches ToolPlane through a trusted reverse proxy
# that overwrites X-Real-IP/X-Forwarded-For. This enables per-address Agent API
# authentication admission limits; global limits remain active when unset.
# AGENT_API_TRUST_PROXY_HEADERS="true"
# Runtime ownership and process supervision require one active owner per runtime
# domain. Follow docs/RUNTIME_OPERATIONS.zh-CN.md before changing replicas.
# Public contact address used by console help and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Optional password-recovery email delivery. When unset, administrators can
# reset an account with: pnpm account:reset-password -- user@example.com
# SMTP_URL="smtps://username:password@smtp.example.com:465"
# SMTP_FROM="ToolPlane <no-reply@example.com>"
# TOOLPLANE_PASSWORD_RESET_GLOBAL_LIMIT="200"

# Docker Compose publishes the app on this host port. By default it listens on
# all host interfaces so an external proxy can reach it; set APP_HOST_BIND to
# "127.0.0.1" for local-only deployments.
APP_HOST_PORT="10030"
# APP_HOST_BIND="127.0.0.1"
# Optional host publish for the connector WebSocket broker. When TLS terminates
# on a separate proxy host, bind this to a private LAN address such as
# "10.0.10.2" so the proxy can reach the broker directly. Configure the port
# separately with CONNECTOR_WS_HOST_PORT.
CONNECTOR_WS_HOST_BIND="127.0.0.1"

# Docker Compose app image. The published image is amd64 for server deployments.
TOOLPLANE_IMAGE="ghcr.io/asharca/toolplane:latest"
TOOLPLANE_PLATFORM="linux/amd64"
TOOLPLANE_UPDATE_ENABLED="true"
TOOLPLANE_UPDATE_REPO="asharca/ToolPlane"
TOOLPLANE_UPDATE_ARTIFACT="toolplane-runtime-linux-amd64.tar.gz"

# MCP startup watchdog settings in milliseconds. These Compose defaults allow
# quiet cold installs from npm, PyPI, or GitHub; Admin > Settings may override
# them for subsequent MCP starts. Keep the maximum at least the idle timeout.
TOOLPLANE_MCP_STARTUP_IDLE_TIMEOUT_MS="300000"
TOOLPLANE_MCP_STARTUP_MAX_TIMEOUT_MS="900000"

# Default for trusted internal Remote MCP targets. Admin > Settings can override
# this with exact DNS hosts, wildcard suffixes such as *.internal.example.com,
# or exact RFC1918/ULA IP addresses. Loopback, link-local, and every unlisted
# host remain blocked.
# TOOLPLANE_REMOTE_MCP_PRIVATE_HOSTS="*.internal.example.com,10.0.10.42"

# Node's default HTTP request timeout can be too short for very large request
# bodies. The production launcher used by Compose and `pnpm start` defaults this
# process-wide request-body timeout to four hours; keep matching proxy read
# timeouts only on routes that legitimately accept large bodies.
# TOOLPLANE_HTTP_REQUEST_TIMEOUT_MS="14400000"

# WebSocket broker for user-machine connector sandboxes.
# `CONNECTOR_WS_PUBLIC_URL` should be the browser-visible ws/wss origin
# (for example `wss://tp.rhzy.ai`). Proxy `/connect` and `/screen/*` WebSocket
# upgrades to this broker. `CONNECTOR_WS_HOST_BIND` controls the private
# host:port Docker publishes for an external reverse proxy to reach.
CONNECTOR_WS_BIND="0.0.0.0"
CONNECTOR_WS_PORT="9321"
CONNECTOR_WS_PUBLIC_URL="ws://localhost:9321"

# Comma-separated emails that are auto-promoted to admin on login/signup.
ADMIN_EMAILS=

# One runtime owner per database/domain. All processes touching the same Docker
# resources must use the same domain. This is NOT an active-active HA switch.
TOOLPLANE_RUNTIME_DOMAIN="default"
# After a dirty shutdown only: stop the old owner and confirm external operations
# ended, then acknowledge the exact UUID printed in the startup error for ONE boot.
# TOOLPLANE_RUNTIME_RECOVERY_ACK=""

# Shared attachment size ceiling; not snapshots/imports/Connector disks.
TOOLPLANE_ATTACHMENT_HARD_MAX_BYTES="2000000000"

# Native A2A task size/character limits. Unset = built-in defaults
# (262144/20000/65536/524288/32768); invalid values fail startup. Keep the
# per-task output charge >= the dailyOutputCharacterLimit floor enforced by the
# database (200000) or native tasks can never claim.
# TOOLPLANE_A2A_BODY_BYTES=262144
# TOOLPLANE_A2A_INPUT_CHARACTERS=20000
# TOOLPLANE_A2A_OUTPUT_CHARACTERS=65536
# TOOLPLANE_A2A_SNAPSHOT_BYTES=524288
# TOOLPLANE_A2A_PUBLISH_ARTIFACT_BYTES=32768

# Default-deny remote A2A egress. Only exact HTTPS origins with public DNS/IPs.
# Approves the network destination, not Agent access; enable and authorize in the console separately.
TOOLPLANE_A2A_REMOTE_ORIGINS='[]'
# Example: '["https://agents.partner.example"]' (no path, wildcard, query or credential).

# Canonical public origin for sandbox MCP/OAuth discovery (HTTPS in production).
# Defaults to NEXT_PUBLIC_APP_URL. Do not include a path or trailing query.
# TOOLPLANE_PUBLIC_URL=https://toolplane.example.com
# Administrator-owned SSH target allowlist, mounted read-only with SSH keys.
# TOOLPLANE_SSH_TARGETS_FILE=/run/toolplane-ssh/targets.json

# Server-only high-entropy master for per-registry webhook keys. Never share it
# with GitHub/users: workspace owners request each registry's derived secret.
# Unset disables webhooks, not manual sync. Repository read tokens stay per-registry.
# TOOLPLANE_RESOURCE_REGISTRY_WEBHOOK_SECRET=""
