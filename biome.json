{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.next",
      "!!**/dist",
      "!!next-env.d.ts",
      "!!.next-dev-wrapper.js",
      "!!tests/fixtures"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@primer/octicons-react": "Use lucide-react icons instead.",
              "react-icons": "Use lucide-react icons instead.",
              "@paper-design/shaders-react": "Unused shader dependency removed."
            }
          }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
