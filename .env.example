DATABASE_URL="postgresql://mcp:mcp@localhost:5433/toolplane?schema=public"

# Secret used to sign session JWT cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL used in generated install scripts, callbacks, and connection snippets.
NEXT_PUBLIC_APP_URL="http://localhost:10030"
# Set only when every request reaches ToolPlane through a trusted reverse proxy
# that overwrites X-Real-IP/X-Forwarded-For. This enables per-address Agent API
# authentication admission limits; global limits remain active when unset.
# AGENT_API_TRUST_PROXY_HEADERS="true"
# IMPORTANT: public Hermes execution currently supports exactly one
# runtime-owning ToolPlane app process/replica. Its Hermes/Docker supervisor,
# execution queue, runtime write leases, and MCP subprocess table are
# process-local; Postgres admission locks do not make this path active-active.
# Do not scale the ToolPlane app horizontally while public Agent APIs are enabled.
# Public contact address used by console help and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Optional password-recovery email delivery. When unset, administrators can
# reset an account with: pnpm account:reset-password -- user@example.com
# SMTP_URL="smtps://username:password@smtp.example.com:465"
# SMTP_FROM="ToolPlane <no-reply@example.com>"
# TOOLPLANE_PASSWORD_RESET_GLOBAL_LIMIT="200"

# Docker Compose publishes the app on this host port. By default it listens on
# all host interfaces so an external proxy can reach it; set APP_HOST_BIND to
# "127.0.0.1" for local-only deployments.
APP_HOST_PORT="10030"
# APP_HOST_BIND="127.0.0.1"
# Optional host publish for the connector WebSocket broker. When TLS terminates
# on a separate proxy host, bind this to a private LAN address such as
# "10.0.10.2" so the proxy can reach the broker directly. Configure the port
# separately with CONNECTOR_WS_HOST_PORT.
CONNECTOR_WS_HOST_BIND="127.0.0.1"

# Docker Compose app image. The published image is amd64 for server deployments.
TOOLPLANE_IMAGE="ghcr.io/asharca/toolplane:latest"
TOOLPLANE_PLATFORM="linux/amd64"
TOOLPLANE_UPDATE_ENABLED="true"
TOOLPLANE_UPDATE_REPO="asharca/ToolPlane"
TOOLPLANE_UPDATE_ARTIFACT="toolplane-runtime-linux-amd64.tar.gz"

# Optional Docker image build override for bundled hosted agent messaging runners.
HERMES_REPO="https://github.com/NousResearch/hermes-agent.git"
HERMES_REF="7e8f50a14176e02b514631b0b04470acaadae32a"
# HERMES_ARCHIVE_URL="https://github.com/NousResearch/hermes-agent/archive/7e8f50a14176e02b514631b0b04470acaadae32a.tar.gz"

# Default Docker image for a new Hermes Agent when no version is explicitly
# selected. Individual Hermes Agents can select or upgrade to a pinned version
# from their Settings page.
# TOOLPLANE_HERMES_IMAGE="nousresearch/hermes-agent:latest"
# Reviewed release tags are pulled and resolved to an immutable registry digest
# when an Endpoint revision is published. This optional comma-separated list
# additionally approves exact public-runtime image digests. Only
# `repository@sha256:<64 hex>` entries are accepted; mutable tags are ignored.
# TOOLPLANE_PUBLIC_HERMES_IMAGES="registry.example.com/hermes@sha256:..."

# Local `pnpm dev` only: Compose images already bundle these paths.
# TOOLPLANE_HERMES_ROOT="/absolute/path/to/hermes-agent"
# TOOLPLANE_PYTHON="/absolute/path/to/python"

# Fallback maximum streamed agent attachment size in bytes. An override saved
# under Admin > Settings takes precedence. Files are stored in the Hermes
# workspace and only their path/metadata is added to chat context. Defaults to 1 GB.
# TOOLPLANE_MAX_ATTACHMENT_BYTES="1000000000"

# MCP startup watchdog settings in milliseconds. These Compose defaults allow
# quiet cold installs from npm, PyPI, or GitHub; Admin > Settings may override
# them for subsequent MCP starts. Keep the maximum at least the idle timeout.
TOOLPLANE_MCP_STARTUP_IDLE_TIMEOUT_MS="300000"
TOOLPLANE_MCP_STARTUP_MAX_TIMEOUT_MS="900000"

# Hermes archive imports stream raw ZIP bytes to disk. Outside Docker Compose,
# set this to a dedicated writable staging directory. A 10 GiB import can need
# roughly 40 GiB free across app staging and Docker copy phases.
# TOOLPLANE_HERMES_ARCHIVE_TMP_DIR="/var/lib/toolplane/imports"
# Docker Compose keeps the container path above fixed and mounts this source
# there. Set an absolute host path such as /srv/toolplane/imports to use a
# dedicated disk instead of the default named volume; make it writable by the
# container's node user. Do not mount one staging source into multiple active
# ToolPlane app instances; archive import locking is single-app crash recovery,
# not a distributed lock service.
# TOOLPLANE_HERMES_ARCHIVE_VOLUME="/srv/toolplane/imports"
# Node's default HTTP request timeout is too short for slow 10 GiB uploads.
# The production launcher used by Compose and `pnpm start` defaults this
# process-wide request-body timeout to four hours. The full import handler can
# run for up to 14 hours while Docker copies the archive, so give this route a
# matching proxy response/read timeout; keep shorter limits and connection/rate
# controls on unrelated reverse-proxy paths. Values below one minute fall back
# to the default. `pnpm dev` keeps Next's development-server timeout and is not
# intended for a full 10 GiB import.
# TOOLPLANE_HTTP_REQUEST_TIMEOUT_MS="14400000"

# WebSocket broker for user-machine connector sandboxes.
# `CONNECTOR_WS_PUBLIC_URL` should be the browser-visible ws/wss endpoint
# (for example `wss://tp.rhzy.ai`), while `CONNECTOR_WS_HOST_BIND` controls the
# private host:port Docker publishes for an external reverse proxy to reach.
CONNECTOR_WS_BIND="0.0.0.0"
CONNECTOR_WS_PORT="9321"
CONNECTOR_WS_PUBLIC_URL="ws://localhost:9321"

# Separate browser origin for the embedded Hermes Dashboard. Local `pnpm dev`
# derives http://<current-host>:9332 automatically. HTTPS deployments must put
# this origin behind TLS and reverse-proxy it to the app's port 9332.
HERMES_DASHBOARD_BIND="0.0.0.0"
HERMES_DASHBOARD_PORT="9332"
# Docker Compose host publish. Use 127.0.0.1 when only a local TLS reverse
# proxy should reach the broker; the signed capability still gates requests.
HERMES_DASHBOARD_HOST_BIND="0.0.0.0"
HERMES_DASHBOARD_HOST_PORT="9332"
# HERMES_DASHBOARD_PUBLIC_URL="https://hermes.example.com"

# Comma-separated emails that are auto-promoted to admin on login/signup.
ADMIN_EMAILS=
