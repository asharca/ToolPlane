generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
}

enum McpToolExposure {
  all
  allowlist
}

model Server {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  author        String?
  description   String?
  iconUrl       String?
  stars         Int            @default(0)
  isOfficial    Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  curated       Boolean        @default(false)
  installCfg    Json?
  verifiedAt    DateTime?
  verifiedTools Int?
  readme        String?
  categories    Category[]     @relation("ServerCategories")
  deployments   Deployment[]
  marketListing MarketListing? @relation("MarketListingSourceServer")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  name                   String?
  passwordHash           String
  sessionVersion         Int                   @default(0)
  role                   UserRole              @default(user)
  status                 UserStatus            @default(active)
  locale                 String                @default("en")
  detectedTimeZone       String?
  timeZoneOverride       String?
  apiTokens              ApiToken[]
  passwordResetTokens    PasswordResetToken[]
  ownedWorkspaces        Workspace[]           @relation("WorkspaceOwner")
  memberships            Membership[]
  agentListings          AgentListing[]        @relation("AgentListingPublisher")
  reviewedAgentReleases  AgentRelease[]        @relation("AgentReleaseReviewer")
  agentInstalls          AgentInstall[]        @relation("AgentInstallActor")
  marketListings         MarketListing[]       @relation("MarketListingPublisher")
  reviewedMarketReleases MarketRelease[]       @relation("MarketReleaseReviewer")
  marketInstalls         MarketInstall[]       @relation("MarketInstallActor")
  createdAgentEndpoints  AgentEndpoint[]       @relation("AgentEndpointCreator")
  createdAgentApiClients AgentApiClient[]      @relation("AgentApiClientCreator")
  resolvedWorkApprovals  WorkApproval[]        @relation("WorkApprovalResolver")
  uploadedAttachments    WorkspaceAttachment[] @relation("WorkspaceAttachmentUploader")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolkitId  String?
  toolkit    Toolkit?  @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([toolkitId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Client {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  author      String?
  description String?
  iconUrl     String?
  stars       Int        @default(0)
  categories  Category[] @relation("ClientCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Skill {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  author         String?
  description    String?
  iconUrl        String?
  githubSource   String?
  sourceRegistry String?
  sourcePath     String?
  sourceSha      String?
  content        String?
  files          Json?
  score          Int              @default(0)
  curated        Boolean          @default(false)
  categories     Category[]       @relation("SkillCategories")
  installs       InstalledSkill[]
  marketListing  MarketListing?   @relation("MarketListingSourceSkill")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Category {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  servers        Server[]        @relation("ServerCategories")
  clients        Client[]        @relation("ClientCategories")
  skills         Skill[]         @relation("SkillCategories")
  agentListings  AgentListing[]  @relation("AgentListingCategories")
  marketListings MarketListing[] @relation("MarketListingCategories")
  toolkits       Toolkit[]       @relation("ToolkitCategories")
}

model DailySnapshot {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  date       DateTime @db.Date
  rank       Int
  score      Int

  @@unique([entityType, entityId, date])
}

model Workspace {
  id                     String                   @id @default(cuid())
  slug                   String                   @unique
  name                   String
  defaultModelProviderId String?
  defaultModel           String?
  titleModelProviderId   String?
  titleModel             String?
  ownerId                String
  owner                  User                     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                Membership[]
  deployments            Deployment[]
  installedSkills        InstalledSkill[]
  requestLogs            RequestLog[]
  sandboxes              Sandbox[]
  toolkits               Toolkit[]
  modelProviders         ModelProvider[]
  chatAssistants         ChatAssistant[]
  chatThreads            ChatThread[]
  agents                 Agent[]
  agentRuntimes          AgentRuntime[]
  agentAttachments       AgentAttachment[]
  workspaceAttachments   WorkspaceAttachment[]
  agentChannels          AgentChannelConnection[]
  workSessions           WorkSession[]
  knowledgeBases         KnowledgeBase[]
  agentListings          AgentListing[]           @relation("AgentListingWorkspace")
  agentInstalls          AgentInstall[]           @relation("AgentInstallWorkspace")
  marketListings         MarketListing[]          @relation("MarketListingPublisherWorkspace")
  marketInstalls         MarketInstall[]          @relation("MarketInstallWorkspace")
  agentEndpoints         AgentEndpoint[]
  skillInvocations       SkillInvocation[]
  syncEvents             SyncEvent[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model Deployment {
  id                  String                  @id @default(cuid())
  workspaceId         String
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serverId            String?
  server              Server?                 @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name                String?
  source              String?
  sourceRef           String?
  installCfg          Json?
  status              String                  @default("provisioning")
  mcpToolExposure     McpToolExposure         @default(all)
  mcpAllowedTools     String[]                @default([])
  // Explicit owner review gate for untrusted public Agent prompts. Internal
  // Agent use and a public multi-tenant API are deliberately separate grants.
  publicInvocable     Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  toolkitLinks        ToolkitServer[]
  agentLinks          AgentServer[]
  chatAssistantGrants ChatAssistantMcpGrant[]
  configFiles         DeploymentConfigFile[]
  sandbox             Sandbox?
  sourceMarketListing MarketListing?          @relation("MarketListingSourceDeployment")
  marketInstall       MarketInstall?          @relation("MarketInstallDeployment")

  @@unique([workspaceId, serverId])
}

model DeploymentConfigFile {
  id               String     @id @default(cuid())
  deploymentId     String
  deployment       Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  path             String
  pathKey          String
  encryptedContent Json
  size             Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([deploymentId, pathKey])
  @@index([deploymentId, updatedAt])
}

model Sandbox {
  id                 String              @id @default(cuid())
  workspaceId        String
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deploymentId       String              @unique
  deployment         Deployment          @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  kind               String              @default("docker")
  image              String?
  hostRoot           String?
  network            String              @default("isolated")
  config             Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentLinks         AgentSandbox[]
  agentRuntime       AgentRuntime?
  snapshots          SandboxSnapshot[]
  workSessions       WorkSession[]
  knowledgeDocuments KnowledgeDocument[]

  @@unique([workspaceId, slug])
}

model SandboxSnapshot {
  id         String   @id @default(cuid())
  sandboxId  String
  sandbox    Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  name       String
  volumeName String   @unique
  status     String   @default("creating")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sandboxId, createdAt])
}

model InstalledSkill {
  id                  String         @id @default(cuid())
  workspaceId         String
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skillId             String?
  skill               Skill?         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  name                String?
  slug                String?
  description         String?
  content             String?
  source              String?
  sourceRef           String?
  status              String         @default("published")
  userInvocable       Boolean        @default(true)
  agentInvocable      Boolean        @default(true)
  effort              String         @default("default")
  files               Json?
  createdAt           DateTime       @default(now())
  toolkitLinks        ToolkitSkill[]
  agentLinks          AgentSkill[]
  sourceMarketListing MarketListing? @relation("MarketListingSourceInstalledSkill")
  marketInstall       MarketInstall? @relation("MarketInstallInstalledSkill")

  @@unique([workspaceId, skillId])
}

model RequestLog {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deploymentId String?
  method       String
  path         String
  statusCode   Int
  durationMs   Int
  requestBody  String?
  responseBody String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, deploymentId, createdAt])
}

model Toolkit {
  id                  String               @id @default(cuid())
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  visibility          String               @default("private")
  enabled             Boolean              @default(true)
  categories          Category[]           @relation("ToolkitCategories")
  servers             ToolkitServer[]
  skills              ToolkitSkill[]
  agentLinks          AgentToolkit[]
  installLinks        ToolkitInstallLink[]
  apiTokens           ApiToken[]
  skillInvocations    SkillInvocation[]
  syncEvents          SyncEvent[]
  sourceMarketListing MarketListing?       @relation("MarketListingSourceToolkit")
  marketInstall       MarketInstall?       @relation("MarketInstallToolkit")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([workspaceId, slug])
}

// Opaque install link for a toolkit (the `/install/<id>` URL). `id` is the
// unguessable public id → (toolkit, user) mapping; it stores NO token. Each
// install fetch mints/rotates a single named API token
// ("MCPmarket plugin - <toolkit> (<client>)"), so the embedded credential is
// always freshly valid. One link per user per toolkit. The id is a bearer
// secret — anyone with it can mint the owner's install token.
model ToolkitInstallLink {
  id        String   @id
  toolkitId String
  toolkit   Toolkit  @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([toolkitId, userId])
}

model ToolkitServer {
  id           String     @id @default(cuid())
  toolkitId    String
  toolkit      Toolkit    @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([toolkitId, deploymentId])
}

model ToolkitSkill {
  id               String         @id @default(cuid())
  toolkitId        String
  toolkit          Toolkit        @relation(fields: [toolkitId], references: [id], onDelete: Cascade)
  installedSkillId String
  installedSkill   InstalledSkill @relation(fields: [installedSkillId], references: [id], onDelete: Cascade)

  @@unique([toolkitId, installedSkillId])
}

model ModelProvider {
  id              String               @id @default(cuid())
  workspaceId     String
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  format          String
  baseUrl         String
  apiKey          String
  models          String[]             @default([])
  modelsFetchedAt DateTime?
  createdAt       DateTime             @default(now())
  agents          Agent[]
  agentLinks      AgentModelProvider[]
  knowledgeBases  KnowledgeBase[]
  chatAssistants  ChatAssistant[]
  modelRecords    ProviderModel[]

  @@unique([workspaceId, name])
}

model ProviderModel {
  id              String        @id @default(cuid())
  providerId      String
  provider        ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId         String
  name            String
  group           String        @default("")
  primaryType     String        @default("text")
  capabilities    String[]      @default([])
  inputModalities String[]      @default([])
  contextWindow   Int?
  maxInputTokens  Int?
  maxOutputTokens Int?
  source          String        @default("remote")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId, primaryType])
}

model Agent {
  id                      String                   @id @default(cuid())
  workspaceId             String
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  systemPrompt            String?
  providerId              String?
  provider                ModelProvider?           @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model                   String?
  runtimeKind             String
  maxSteps                Int                      @default(8)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  servers                 AgentServer[]
  skills                  AgentSkill[]
  toolkits                AgentToolkit[]
  sandboxes               AgentSandbox[]
  subAgents               AgentSubAgent[]          @relation("AgentParent")
  parentLinks             AgentSubAgent[]          @relation("AgentChild")
  conversations           Conversation[]
  workSessions            WorkSession[]
  knowledgeBases          AgentKnowledgeBase[]
  channels                AgentChannelConnection[]
  runtime                 AgentRuntime?
  attachments             AgentAttachment[]
  marketListing           AgentListing?            @relation("AgentListingSource")
  marketInstall           AgentInstall?            @relation("AgentInstallAgent")
  sourceMarketListing     MarketListing?           @relation("MarketListingSourceAgent")
  unifiedMarketInstall    MarketInstall?           @relation("MarketInstallAgent")
  modelProviders          AgentModelProvider[]
  publicEndpoints         AgentEndpoint[]          @relation("EndpointSourceAgent")
  publicRuntimeAllocation AgentEndpointRuntime?    @relation("EndpointRuntimeAgent")

  @@unique([workspaceId, slug])
}

model AgentModelProvider {
  agentId    String
  agent      Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  providerId String
  provider   ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@id([agentId, providerId])
  @@index([providerId])
}

// Public marketplace metadata is separate from the mutable workspace Agent.
// The listing points at an immutable release artifact; no runtime secret or
// workspace-owned tool id is exposed through this model.
model AgentListing {
  id                   String         @id @default(cuid())
  publisherKind        String         @default("workspace")
  publisherWorkspaceId String?
  publisherWorkspace   Workspace?     @relation("AgentListingWorkspace", fields: [publisherWorkspaceId], references: [id], onDelete: SetNull)
  sourceAgentId        String?        @unique
  sourceAgent          Agent?         @relation("AgentListingSource", fields: [sourceAgentId], references: [id], onDelete: SetNull)
  publishedById        String?
  publishedBy          User?          @relation("AgentListingPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  slug                 String
  directorySlug        String         @unique
  name                 String
  author               String?
  summary              String?
  iconUrl              String?
  tags                 String[]       @default([])
  status               String         @default("draft")
  curated              Boolean        @default(false)
  isFeatured           Boolean        @default(false)
  latestVersion        Int            @default(0)
  latestReleaseId      String?        @unique
  latestRelease        AgentRelease?  @relation("AgentListingLatestRelease", fields: [latestReleaseId], references: [id], onDelete: SetNull)
  pendingReleaseId     String?        @unique
  pendingRelease       AgentRelease?  @relation("AgentListingPendingRelease", fields: [pendingReleaseId], references: [id], onDelete: SetNull)
  installCount         Int            @default(0)
  publishedAt          DateTime?
  releases             AgentRelease[] @relation("AgentListingReleases")
  categories           Category[]     @relation("AgentListingCategories")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([publisherWorkspaceId, slug])
  @@index([status, isFeatured, installCount, publishedAt])
  @@index([pendingReleaseId, updatedAt])
}

// Append-only, versioned public artifact. `manifest` is an explicitly
// allowlisted portable definition and never contains provider keys, MCP env
// values, channel credentials, conversations, attachments, or runtime state.
model AgentRelease {
  id              String         @id @default(cuid())
  listingId       String
  listing         AgentListing   @relation("AgentListingReleases", fields: [listingId], references: [id], onDelete: Cascade)
  version         Int
  manifestVersion Int            @default(1)
  manifest        Json
  releaseSummary  Json
  checksum        String
  name            String
  summary         String?
  iconUrl         String?
  tags            String[]       @default([])
  categoryIds     String[]       @default([])
  reviewStatus    String         @default("pending")
  reviewedById    String?
  reviewedBy      User?          @relation("AgentReleaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNote      String?
  publishedAt     DateTime       @default(now())
  latestFor       AgentListing?  @relation("AgentListingLatestRelease")
  pendingFor      AgentListing?  @relation("AgentListingPendingRelease")
  installs        AgentInstall[]

  @@unique([listingId, version])
  @@index([listingId, publishedAt])
  @@index([reviewStatus, publishedAt])
  @@index([reviewedById])
}

// One materialization attempt that produced a private target-workspace Agent.
// requirements contain only secret *names* (never values) and model requirements;
// resourceMap contains only newly-created target workspace ids.
model AgentInstall {
  id                String       @id @default(cuid())
  releaseId         String
  release           AgentRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  targetWorkspaceId String
  targetWorkspace   Workspace    @relation("AgentInstallWorkspace", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)
  installedById     String?
  installedBy       User?        @relation("AgentInstallActor", fields: [installedById], references: [id], onDelete: SetNull)
  agentId           String?      @unique
  agent             Agent?       @relation("AgentInstallAgent", fields: [agentId], references: [id], onDelete: SetNull)
  idempotencyKey    String
  status            String       @default("needs_setup")
  requirements      Json
  resourceMap       Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([targetWorkspaceId, idempotencyKey])
  @@index([releaseId, createdAt])
  @@index([targetWorkspaceId, createdAt])
}

// Shared marketplace metadata for MCP servers, skills, toolkits, agents, and assistants.
// A listing may retain its public identity after its workspace source is removed.
model MarketListing {
  id                     String          @id @default(cuid())
  kind                   String
  namespace              String
  slug                   String
  publisherKind          String          @default("workspace")
  publisherWorkspaceId   String?
  publisherWorkspace     Workspace?      @relation("MarketListingPublisherWorkspace", fields: [publisherWorkspaceId], references: [id], onDelete: SetNull)
  publishedById          String?
  publishedBy            User?           @relation("MarketListingPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  sourceServerId         String?         @unique
  sourceServer           Server?         @relation("MarketListingSourceServer", fields: [sourceServerId], references: [id], onDelete: SetNull)
  sourceSkillId          String?         @unique
  sourceSkill            Skill?          @relation("MarketListingSourceSkill", fields: [sourceSkillId], references: [id], onDelete: SetNull)
  sourceDeploymentId     String?         @unique
  sourceDeployment       Deployment?     @relation("MarketListingSourceDeployment", fields: [sourceDeploymentId], references: [id], onDelete: SetNull)
  sourceInstalledSkillId String?         @unique
  sourceInstalledSkill   InstalledSkill? @relation("MarketListingSourceInstalledSkill", fields: [sourceInstalledSkillId], references: [id], onDelete: SetNull)
  sourceToolkitId        String?         @unique
  sourceToolkit          Toolkit?        @relation("MarketListingSourceToolkit", fields: [sourceToolkitId], references: [id], onDelete: SetNull)
  sourceAgentId          String?         @unique
  sourceAgent            Agent?          @relation("MarketListingSourceAgent", fields: [sourceAgentId], references: [id], onDelete: SetNull)
  sourceChatAssistantId  String?         @unique
  sourceChatAssistant    ChatAssistant?  @relation("MarketListingSourceChatAssistant", fields: [sourceChatAssistantId], references: [id], onDelete: SetNull)
  name                   String
  summary                String?
  iconUrl                String?
  tags                   String[]        @default([])
  categories             Category[]      @relation("MarketListingCategories")
  metadata               Json
  status                 String          @default("draft")
  curated                Boolean         @default(false)
  isFeatured             Boolean         @default(false)
  latestVersion          Int             @default(0)
  latestReleaseId        String?         @unique
  latestRelease          MarketRelease?  @relation("MarketListingLatestRelease", fields: [latestReleaseId], references: [id], onDelete: SetNull)
  pendingReleaseId       String?         @unique
  pendingRelease         MarketRelease?  @relation("MarketListingPendingRelease", fields: [pendingReleaseId], references: [id], onDelete: SetNull)
  installCount           Int             @default(0)
  publishedAt            DateTime?
  releases               MarketRelease[] @relation("MarketListingReleases")
  installs               MarketInstall[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([namespace, slug])
  @@index([kind, status, isFeatured, installCount, publishedAt])
  @@index([publisherWorkspaceId, status, updatedAt])
  @@index([pendingReleaseId, updatedAt])
}

// Append-only release artifact. The manifest is portable and must contain no
// provider keys, environment values, credentials, conversations, or runtime state.
model MarketRelease {
  id              String          @id @default(cuid())
  listingId       String
  listing         MarketListing   @relation("MarketListingReleases", fields: [listingId], references: [id], onDelete: Cascade)
  version         Int
  manifestVersion Int             @default(1)
  manifest        Json
  releaseSummary  Json
  checksum        String
  releaseNotes    String?
  categoryIds     String[]        @default([])
  scanResult      Json?
  reviewStatus    String          @default("pending")
  reviewedById    String?
  reviewedBy      User?           @relation("MarketReleaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNote      String?
  publishedAt     DateTime?
  latestFor       MarketListing?  @relation("MarketListingLatestRelease")
  pendingFor      MarketListing?  @relation("MarketListingPendingRelease")
  currentInstalls MarketInstall[] @relation("MarketInstallCurrentRelease")
  ignoredBy       MarketInstall[] @relation("MarketInstallIgnoredRelease")
  requestedBy     MarketInstall[] @relation("MarketInstallRequestedRelease")
  chatAssistants  ChatAssistant[] @relation("ChatAssistantMarketTemplate")
  createdAt       DateTime        @default(now())

  @@unique([listingId, version])
  @@index([listingId, publishedAt])
  @@index([reviewStatus, createdAt])
  @@index([reviewedById])
}

// Tracks one installed listing per workspace. requirements and resourceMap may
// contain names and target resource ids, but never credential values.
model MarketInstall {
  id                 String          @id @default(cuid())
  listingId          String
  listing            MarketListing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  currentReleaseId   String
  currentRelease     MarketRelease   @relation("MarketInstallCurrentRelease", fields: [currentReleaseId], references: [id], onDelete: Restrict)
  requestedReleaseId String
  requestedRelease   MarketRelease   @relation("MarketInstallRequestedRelease", fields: [requestedReleaseId], references: [id], onDelete: Restrict)
  ignoredReleaseId   String?
  ignoredRelease     MarketRelease?  @relation("MarketInstallIgnoredRelease", fields: [ignoredReleaseId], references: [id], onDelete: SetNull)
  targetWorkspaceId  String
  targetWorkspace    Workspace       @relation("MarketInstallWorkspace", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)
  installedById      String?
  installedBy        User?           @relation("MarketInstallActor", fields: [installedById], references: [id], onDelete: SetNull)
  deploymentId       String?         @unique
  deployment         Deployment?     @relation("MarketInstallDeployment", fields: [deploymentId], references: [id], onDelete: SetNull)
  installedSkillId   String?         @unique
  installedSkill     InstalledSkill? @relation("MarketInstallInstalledSkill", fields: [installedSkillId], references: [id], onDelete: SetNull)
  toolkitId          String?         @unique
  toolkit            Toolkit?        @relation("MarketInstallToolkit", fields: [toolkitId], references: [id], onDelete: SetNull)
  agentId            String?         @unique
  agent              Agent?          @relation("MarketInstallAgent", fields: [agentId], references: [id], onDelete: SetNull)
  idempotencyKey     String
  status             String          @default("installing")
  updatePolicy       String          @default("manual")
  requirements       Json?
  resourceMap        Json?
  lastCheckedAt      DateTime?
  lastError          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([targetWorkspaceId, listingId])
  @@unique([targetWorkspaceId, idempotencyKey])
  @@index([listingId, status, updatedAt])
  @@index([currentReleaseId, createdAt])
  @@index([requestedReleaseId, createdAt])
  @@index([targetWorkspaceId, status, updatedAt])
}

model AgentRuntime {
  id            String            @id @default(cuid())
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId       String            @unique
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sandboxId     String            @unique
  sandbox       Sandbox           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  kind          String            @default("hermes")
  image         String
  status        String            @default("provisioning")
  configVersion Int               @default(1)
  configHash    String?
  capabilities  Json?
  lastSyncedAt  DateTime?
  lastStartedAt DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  attachments   AgentAttachment[]

  @@index([workspaceId, kind, status])
}

model AgentAttachment {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  runtimeId      String?
  runtime        AgentRuntime? @relation(fields: [runtimeId], references: [id], onDelete: SetNull)
  name           String
  mimeType       String
  size           Int
  storage        String        @default("hermes-volume")
  storagePath    String
  createdAt      DateTime      @default(now())

  @@index([workspaceId, agentId, createdAt])
  @@index([conversationId])
}

model WorkspaceAttachment {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User          @relation("WorkspaceAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  chatThreadId   String?
  chatThread     ChatThread?   @relation(fields: [chatThreadId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  mimeType       String
  size           Int
  storagePath    String
  extractedText  String?
  createdAt      DateTime      @default(now())

  @@unique([workspaceId, storagePath])
  @@index([workspaceId, createdAt])
  @@index([chatThreadId])
  @@index([conversationId])
}

model AgentChannelConnection {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId            String
  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  platform           String
  name               String
  status             String    @default("stopped")
  config             Json?
  credentials        Json?
  inboundTokenHash   String    @unique
  inboundTokenSecret Json
  inboundTokenPrefix String
  runnerPid          Int?
  lastError          String?
  lastStartedAt      DateTime?
  lastEventAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([agentId, platform, name])
  @@index([workspaceId, agentId])
  @@index([platform, status])
}

// A directed link letting one agent delegate to another (same workspace) by
// calling it as a tool. Self-relation: parent → child.
model AgentSubAgent {
  parentId String
  childId  String
  parent   Agent  @relation("AgentParent", fields: [parentId], references: [id], onDelete: Cascade)
  child    Agent  @relation("AgentChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
}

model AgentServer {
  agentId      String
  deploymentId String
  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@id([agentId, deploymentId])
}

model AgentSkill {
  agentId          String
  installedSkillId String
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  installedSkill   InstalledSkill @relation(fields: [installedSkillId], references: [id], onDelete: Cascade)

  @@id([agentId, installedSkillId])
}

model AgentToolkit {
  agentId   String
  toolkitId String
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolkit   Toolkit @relation(fields: [toolkitId], references: [id], onDelete: Cascade)

  @@id([agentId, toolkitId])
}

model AgentSandbox {
  agentId   String
  sandboxId String
  isDefault Boolean @default(false)
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sandbox   Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@id([agentId, sandboxId])
  @@unique([sandboxId])
  @@index([agentId, isDefault])
}

model WorkSession {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId            String
  agent              Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sandboxId          String?
  sandbox            Sandbox?       @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  conversationId     String         @unique
  conversation       Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title              String?
  task               String?
  acceptanceCriteria String?
  runtimeKind        String
  runtimeSnapshot    Json?
  status             String         @default("queued")
  maxSteps           Int            @default(12)
  stepCount          Int            @default(0)
  waitingQuestion    String?
  result             String?
  artifacts          Json?
  error              String?
  deadlineAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelRequestedAt  DateTime?
  approvals          WorkApproval[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([workspaceId, agentId, updatedAt])
  @@index([status, createdAt])
  @@index([sandboxId])
}

model WorkApproval {
  id            String      @id @default(cuid())
  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  toolCallId    String
  toolName      String
  input         Json
  status        String      @default("pending")
  resolvedById  String?
  resolvedBy    User?       @relation("WorkApprovalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  requestedAt   DateTime    @default(now())
  resolvedAt    DateTime?

  @@unique([workSessionId, toolCallId])
  @@index([workSessionId, status, requestedAt])
  @@index([resolvedById])
}

model KnowledgeBase {
  id             String               @id @default(cuid())
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  providerId     String?
  provider       ModelProvider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  embeddingModel String
  dimensions     Int?
  chunkSize      Int                  @default(1200)
  chunkOverlap   Int                  @default(200)
  topK           Int                  @default(6)
  threshold      Float                @default(0.2)
  documents      KnowledgeDocument[]
  agentLinks     AgentKnowledgeBase[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model KnowledgeDocument {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sandboxId       String?
  sandbox         Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  sourcePath      String
  filename        String
  mimeType        String
  size            Int
  status          String           @default("pending")
  error           String?
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([knowledgeBaseId, updatedAt])
  @@index([sandboxId])
}

model KnowledgeChunk {
  id         String                 @id @default(cuid())
  documentId String
  document   KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  content    String
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())

  @@unique([documentId, ordinal])
  @@index([documentId])
}

model AgentKnowledgeBase {
  agentId         String
  knowledgeBaseId String
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([agentId, knowledgeBaseId])
  @@index([knowledgeBaseId])
}

model Conversation {
  id                    String                   @id @default(cuid())
  agentId               String
  agent                 Agent                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title                 String?
  // Hermes keeps its own state in the runtime volume. These aliases let a
  // cloned ToolPlane conversation retain the source runtime's session identity
  // even though its database primary key must be new.
  runtimeSessionId      String?
  runtimeSessionKey     String?
  // null profile means Hermes' default profile. null provider/model means the
  // conversation follows that profile's configured default model.
  hermesProfile         String?
  hermesProvider        String?
  hermesModel           String?
  // null follows the model/provider default. Explicit values are snapshotted
  // per conversation so one chat cannot change another chat's reasoning level.
  reasoningEffort       String?
  createdAt             DateTime                 @default(now())
  messages              Message[]
  attachments           AgentAttachment[]
  workspaceAttachments  WorkspaceAttachment[]
  publicApiConversation AgentPublicConversation?
  workSession           WorkSession?
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  parts          Json
  textCharacters Int          @default(0)
  // Public API conversations assign a monotonically increasing sequence so a
  // user/assistant turn stays deterministic even when DB timestamps tie.
  sequence       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, sequence])
}

// Chat is deliberately isolated from Agent/Work. It can bind only a model,
// a prompt, and direct MCP deployments; there are no Skill, Sandbox, Toolkit,
// sub-agent, or Runtime relations in this bounded context.
model ChatAssistant {
  id                      String                  @id @default(cuid())
  workspaceId             String
  workspace               Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                    String
  systemPrompt            String?
  modelProviderId         String?
  modelProvider           ModelProvider?          @relation(fields: [modelProviderId], references: [id], onDelete: SetNull)
  model                   String?
  maxSteps                Int                     @default(8)
  marketTemplateReleaseId String?
  marketTemplateRelease   MarketRelease?          @relation("ChatAssistantMarketTemplate", fields: [marketTemplateReleaseId], references: [id], onDelete: SetNull)
  sourceMarketListing     MarketListing?          @relation("MarketListingSourceChatAssistant")
  mcpGrants               ChatAssistantMcpGrant[]
  threads                 ChatThread[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([modelProviderId])
  @@index([marketTemplateReleaseId])
}

model ChatAssistantMcpGrant {
  assistantId  String
  assistant    ChatAssistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  deploymentId String
  deployment   Deployment    @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@id([assistantId, deploymentId])
  @@index([deploymentId])
}

model ChatThread {
  id              String                @id @default(cuid())
  workspaceId     String
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assistantId     String
  assistant       ChatAssistant         @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  activeMessageId String?
  title           String?
  turns           ChatTurn[]
  messages        ChatMessage[]
  attachments     WorkspaceAttachment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([assistantId, updatedAt])
}

model ChatTurn {
  id          String        @id @default(cuid())
  threadId    String
  thread      ChatThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  status      String        @default("pending")
  error       String?
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  @@index([threadId, createdAt])
}

model ChatMessage {
  id             String        @id @default(cuid())
  threadId       String
  thread         ChatThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turnId         String
  turn           ChatTurn      @relation(fields: [turnId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         ChatMessage?  @relation("ChatMessageBranches", fields: [parentId], references: [id], onDelete: SetNull)
  children       ChatMessage[] @relation("ChatMessageBranches")
  siblingGroupId String?
  role           String
  status         String        @default("success")
  modelId        String?
  parts          Json
  createdAt      DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([threadId, parentId, createdAt])
  @@index([threadId, siblingGroupId, createdAt])
  @@index([turnId, createdAt])
}

// Public Agent API control-plane deployment. It is intentionally separate
// from AgentListing: a marketplace artifact is not a callable runtime.
model AgentEndpoint {
  id                        String                    @id @default(cuid())
  publicId                  String                    @unique
  workspaceId               String
  workspace                 Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAgentId             String                    @unique
  sourceAgent               Agent                     @relation("EndpointSourceAgent", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  createdById               String?
  createdBy                 User?                     @relation("AgentEndpointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name                      String
  status                    String                    @default("disabled")
  isolationMode             String                    @default("subject")
  rpmLimit                  Int                       @default(60)
  dailyRequestLimit         Int                       @default(10000)
  dailyOutputCharacterLimit Int                       @default(100000000)
  maxConcurrent             Int                       @default(5)
  maxRuntimes               Int                       @default(100)
  maxStoredCharacters       Int                       @default(250000000)
  timeoutSeconds            Int                       @default(300)
  retentionDays             Int                       @default(30)
  allowedOrigins            String[]                  @default([])
  currentRevisionId         String?                   @unique
  currentRevision           AgentEndpointRevision?    @relation("CurrentEndpointRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions                 AgentEndpointRevision[]   @relation("EndpointRevisions")
  clients                   AgentApiClient[]
  runtimes                  AgentEndpointRuntime[]
  conversations             AgentPublicConversation[]
  runs                      AgentRun[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([workspaceId, status])
}

model AgentEndpointRevision {
  id                String                    @id @default(cuid())
  endpointId        String
  endpoint          AgentEndpoint             @relation("EndpointRevisions", fields: [endpointId], references: [id], onDelete: Cascade)
  version           Int
  systemPrompt      String
  maxSteps          Int                       @default(8)
  runtimeImage      String
  providerIds       String[]                  @default([])
  deploymentIds     String[]                  @default([])
  installedSkillIds String[]                  @default([])
  toolPolicy        Json
  currentFor        AgentEndpoint?            @relation("CurrentEndpointRevision")
  runtimes          AgentEndpointRuntime[]
  conversations     AgentPublicConversation[]
  runs              AgentRun[]
  createdAt         DateTime                  @default(now())

  @@unique([endpointId, version])
  @@index([endpointId, createdAt])
}

model AgentApiClient {
  id                        String                    @id @default(cuid())
  endpointId                String
  endpoint                  AgentEndpoint             @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdById               String?
  createdBy                 User?                     @relation("AgentApiClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name                      String
  status                    String                    @default("active")
  scopes                    String[]                  @default(["responses:create", "responses:read", "conversations:read", "conversations:delete", "client_tokens:create"])
  rpmLimit                  Int                       @default(60)
  dailyRequestLimit         Int                       @default(10000)
  dailyOutputCharacterLimit Int                       @default(20000000)
  maxConcurrent             Int                       @default(5)
  maxStoredCharacters       Int                       @default(50000000)
  keys                      AgentApiKey[]
  conversations             AgentPublicConversation[]
  runs                      AgentRun[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([endpointId, status])
}

model AgentApiKey {
  id         String         @id @default(cuid())
  clientId   String
  client     AgentApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  tokenHash  String         @unique
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([clientId, revokedAt])
}

// A clean hidden Agent/Hermes runtime allocated for either the whole Endpoint
// or one HMAC-namespaced public subject. runtimeAgentId stays nullable while a
// crash-safe reservation is being materialized.
model AgentEndpointRuntime {
  id                 String                    @id @default(cuid())
  endpointId         String
  endpoint           AgentEndpoint             @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  revisionId         String
  revision           AgentEndpointRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  subjectHash        String
  runtimeAgentId     String?                   @unique
  runtimeAgent       Agent?                    @relation("EndpointRuntimeAgent", fields: [runtimeAgentId], references: [id], onDelete: SetNull)
  status             String                    @default("provisioning")
  operationId        String?
  operationExpiresAt DateTime?
  lastUsedAt         DateTime?
  lastError          String?
  conversations      AgentPublicConversation[]
  runs               AgentRun[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([endpointId, revisionId, subjectHash])
  @@index([endpointId, lastUsedAt])
  @@index([revisionId])
  @@index([status, lastUsedAt])
  @@index([status, operationExpiresAt])
}

model AgentPublicConversation {
  id                  String                @id @default(cuid())
  publicId            String                @unique
  endpointId          String
  endpoint            AgentEndpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  revisionId          String
  revision            AgentEndpointRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  clientId            String
  client              AgentApiClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runtimeAllocationId String
  runtimeAllocation   AgentEndpointRuntime  @relation(fields: [runtimeAllocationId], references: [id], onDelete: Cascade)
  conversationId      String                @unique
  conversation        Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectHash         String
  storedCharacters    Int                   @default(0)
  deletingAt          DateTime?
  runs                AgentRun[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([endpointId, clientId, subjectHash, createdAt])
  @@index([endpointId, createdAt])
  @@index([clientId])
  @@index([revisionId])
  @@index([runtimeAllocationId, createdAt])
}

model AgentRun {
  id                   String                   @id @default(cuid())
  publicId             String                   @unique
  requestId            String                   @unique
  endpointId           String
  endpoint             AgentEndpoint            @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  revisionId           String
  revision             AgentEndpointRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  clientId             String
  client               AgentApiClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subjectHash          String
  publicConversationId String?
  publicConversation   AgentPublicConversation? @relation(fields: [publicConversationId], references: [id], onDelete: SetNull)
  runtimeAllocationId  String?
  runtimeAllocation    AgentEndpointRuntime?    @relation(fields: [runtimeAllocationId], references: [id], onDelete: SetNull)
  idempotencyKey       String?
  requestHash          String
  status               String                   @default("provisioning")
  stream               Boolean                  @default(false)
  errorCode            String?
  inputCharacters      Int                      @default(0)
  outputCharacters     Int                      @default(0)
  durationMs           Int?
  outputText           String?
  cancelRequestedAt    DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  // Immutable admission snapshot; maintenance never derives a run's deadline
  // from mutable Endpoint configuration.
  deadlineAt           DateTime
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([endpointId, status, createdAt])
  @@index([publicConversationId, status])
  @@index([clientId, status, createdAt])
  @@index([clientId, subjectHash, createdAt])
  @@index([clientId, createdAt])
  @@index([revisionId])
  @@index([runtimeAllocationId])
  @@index([status, deadlineAt])
}

// Small atomic counters used for minute/day quotas. Request content and
// credentials never enter this table.
model AgentApiUsageBucket {
  key           String
  windowStart   DateTime
  windowSeconds Int
  count         Int      @default(0)
  expiresAt     DateTime

  @@id([key, windowStart, windowSeconds])
  @@index([expiresAt])
}

// Cross-worker lease for bounded maintenance jobs. ownerId is an opaque
// per-invocation nonce and never identifies a customer or request.
model AgentApiMaintenanceLease {
  name      String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// Plugin telemetry: a skill firing inside an installed toolkit plugin. Skills
// live on the user's filesystem and never hit the MCP gateway, so this hook
// POST is the only signal of skill usage. source = user|agent, outcome =
// success|error.
model SkillInvocation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolkitId   String?
  toolkit     Toolkit?  @relation(fields: [toolkitId], references: [id], onDelete: SetNull)
  skillSlug   String
  source      String
  outcome     String
  errorClass  String?
  client      String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// Plugin telemetry: one SessionStart skill-sync run. outcome = applied (with
// added/removed/updated/total counts) or failure (with a reason class).
model SyncEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolkitId   String?
  toolkit     Toolkit?  @relation(fields: [toolkitId], references: [id], onDelete: SetNull)
  outcome     String
  added       Int       @default(0)
  removed     Int       @default(0)
  updated     Int       @default(0)
  total       Int       @default(0)
  reason      String?
  client      String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}
