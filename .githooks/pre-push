#!/bin/sh
set -eu
# Check the exact tree being pushed, not an uncommitted local repair.
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  if [ "$local_oid" != "$(git rev-parse HEAD)" ]; then
    echo "Push checks require checking out the commit being pushed ($local_ref)." >&2
    exit 1
  fi
  if ! git diff --quiet HEAD --; then
    echo "Commit or stash tracked changes before pushing; checks must validate HEAD." >&2
    exit 1
  fi
  pnpm check
done
